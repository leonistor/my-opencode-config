{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "lsp": true,
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "opencode-mem",
    "opencode-history-search",
    "@slkiser/opencode-quota@latest",
    "opencode-pty",
  ],
  "disabled_providers": ["github-copilot", "huggingface"],
  "permission": {
    // .env reads without prompts
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow",
    },
    "*": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "bun *": "allow",
      "bunx *": "allow",
      "git push *": "ask",
      "git checkout *": "allow",
      // Only deny the truly catastrophic - everything else just runs
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny", // fork bomb, just in case
    },
  },
  "instructions": ["~/.config/opencode/docs/index.md"],
  "compaction": {
    "prune": true,
  },
  "mcp": {
    // copy and enable in project config
    /*
    "zig-mcp": {
      "type": "local",
      "enabled": false,
      "command": ["/Users/leo/learn/zig/srcs/zig-mcp/zig-out/bin/zig-mcp"],
    },
    "astro": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.docs.astro.build/mcp",
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest", "--headless"],
    },
    "crawlberg": {
      "enabled": false,
      "type": "local",
      "command": ["crawlberg", "mcp"],
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
    },
    */
  },
  "watcher": {
    "ignore": [
      // "node_modules/**",
      "dist/**",
      ".git/**",
      // ".venv/**",
      "__pycache__/**",
    ],
  },
}
