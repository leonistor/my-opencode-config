{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "lsp": true,
  "plugin": [
    "opencode-history-search",
    "opencode-pty",
    "@upstash/context7-opencode",
    "open-plan-annotator@latest",
    "oh-my-opencode-slim",
  ],
  "disabled_providers": ["github-copilot", "huggingface"],
  "permission": {
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow",
    },
    "*": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "bun *": "allow",
      "bunx *": "allow",
      "git push *": "ask",
      "git checkout *": "allow",
      // Only deny the truly catastrophic - everything else just runs
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny", // fork bomb, just in case
    },
  },
  "compaction": {
    "prune": true,
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
    ],
  },
  "provider": {
    "openrouter": {},
    "opencode-go": {},
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "llama3.2:latest": {
          "reasoning": true,
          "tool_call": true,
        },
        "qwen3.5:9b": {
          "reasoning": true,
          "tool_call": true,
        },
        "qwen2.5-coder:7b-base": {
          "reasoning": true,
          "tool_call": true,
        },
        "gemma2:9b": {
          "reasoning": true,
          "tool_call": true,
        },
      },
    },
  },
}
