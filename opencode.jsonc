{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "plugins": [
    // Not V2-ready yet (no upstream V2 variant):
    // "opencode-history-search",
    // opencode-pty: cannot load as a package spec on V2 (its V2 build is a
    // subpath export, `opencode-pty/v2`, which OpenCode parses as a git spec).
    // Loaded via a local plugin package instead: plugins/opencode-pty/
    "@upstash/context7-opencode",
    "@slkiser/opencode-quota@5", // v5 = OpenCode 2 (v4 = OpenCode 1)
    "./plugins/cmux",
    "oh-my-opencode-slim",
    // Plannotator's own plugin: the Inbox (threads, questions, attachments
    // annotated in place) plus plan review via `submit_plan`, which replaced
    // open-plan-annotator's `annotate_plan`. Two plugins that both register a
    // plan tool inject contradictory system prompts on the `plan` agent, so
    // only one may be loaded — this one. Removed 2026-10-24.
    // The `plannotator_inbox` tool is off by default for OpenCode; the file
    // ~/.plannotator/config.json turns it on via `inboxTool.opencode`. Plugins
    // load at process start, so this applies to a new session, not this one.
    "@plannotator/opencode",
  ],
  "agents": {
    // oh-my-opencode-slim provides its own `explorer` subagent and the
    // `orchestrator`; disable the built-in explore/general agents.
    "explore": { "disabled": true },
    "general": { "disabled": true },
  },
  "policies": [
    // `cmux hooks setup` unconditionally regenerates two loose V1-era plugin
    // files whose default export reuses the id of the real V2 package at
    // ./plugins/cmux. Three entries sharing one plugin id makes the TUI report
    // "2 plugins failed: cmux.server, cmux.server". Denying the loose files
    // keeps cmux's V2 integration (./plugins/cmux, loaded above) working.
    {
      "action": "integration.use",
      "resource": "plugin:/Users/leo/.config/opencode/plugins/cmux-feed.js",
      "effect": "deny",
    },
    {
      "action": "integration.use",
      "resource": "plugin:/Users/leo/.config/opencode/plugins/cmux-session.js",
      "effect": "deny",
    },
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "deny",
    },
    { "action": "provider.use", "resource": "huggingface", "effect": "deny" },
  ],
  "permissions": [
    // V2 rules resolve last-match-wins, and these user rules are appended
    // AFTER shipped agent rules. Do NOT add blanket allow rules here such as
    // `{ "action": "*" }` or `{ "action": "edit" }`: they would override
    // agent-level denials, e.g. the read-only `plan` agent. Every agent
    // already starts from a built-in allow-everything base policy.
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    // V2 defaults to `ask` for `.env`/`.env.*` reads; keep them allowed.
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "read", "resource": "*.env-*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    // Shell rules (V1 `permission.bash`). Only deny the truly catastrophic.
    { "action": "shell", "resource": "bun *", "effect": "allow" },
    { "action": "shell", "resource": "bunx *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    // Deny only exact root/home wipes. Do NOT add `rm -rf /*` or `rm -rf ~/*`:
    // the glob `*` matches across `/`, so those rules also block routine
    // cleanup of absolute paths (e.g. `rm -rf /tmp/x`) and surface to agents as
    // "Permission denied: shell" / a missing shell tool.
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": ":(){:|:&};:", "effect": "deny" }, // fork bomb, just in case
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
    ],
  },
  "providers": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash:floor": {
          "modelID": "z-ai/glm-5.3-flash:floor",
          "name": "GLM-5.3-Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 943717 },
          "cost": { "input": 0.15, "output": 0.5, "cache": { "read": 0.03 } },
        },
        "xiaomi/mimo-v2.6-flash:floor": {
          "modelID": "xiaomi/mimo-v2.6-flash:floor",
          "name": "MiMo-V2.6-Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "audio", "video"],
            "output": ["text"],
          },
          "limit": { "context": 1050000, "output": 131072 },
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache": { "read": 0.0028 },
          },
        },
        "deepseek/deepseek-v4-flash-0731:floor": {
          "modelID": "deepseek/deepseek-v4-flash-0731:floor",
          "name": "DeepSeek V4 Flash 0731 (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 943718 },
          "cost": {
            "input": 0.0152,
            "output": 1.28,
            "cache": { "read": 0.0152 },
          },
        },
        "google/gemini-3.8-flash:floor": {
          "modelID": "google/gemini-3.8-flash:floor",
          "name": "Gemini 3.8 Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video", "audio", "pdf"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 65536 },
          "cost": {
            "input": 0.75,
            "output": 3.75,
            "cache": { "read": 0.075, "write": 0.041667 },
          },
        },
        "moonshotai/kimi-k2.7-code:floor": {
          "modelID": "moonshotai/kimi-k2.7-code:floor",
          "name": "Kimi K2.7 Code (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": { "context": 262144, "output": 235929 },
          "cost": {
            "input": 0.6712,
            "output": 3.35,
            "cache": { "read": 0.18 },
          },
        },
        "qwen/qwen3-coder-30b-a3b-instruct:floor": {
          "modelID": "qwen/qwen3-coder-30b-a3b-instruct:floor",
          "name": "Qwen3 Coder 30B MoE (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
          "limit": { "context": 262144, "output": 65536 },
          "cost": { "input": 0.07, "output": 0.28 },
        },
        "deepseek/deepseek-v4.1-flash:floor": {
          "modelID": "deepseek/deepseek-v4.1-flash:floor",
          "name": "DeepSeek V4.1 Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 943718 },
          "cost": {
            "input": 0.00405,
            "output": 0.72,
            "cache": { "read": 0.0054 },
          },
        },
        "z-ai/glm-5.3:floor": {
          "modelID": "z-ai/glm-5.3:floor",
          "name": "GLM-5.3 (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 943718 },
          "cost": {
            "input": 0.11,
            "output": 6,
            "cache": { "read": 0.109 },
          },
        },
        "minimax/minimax-m3:floor": {
          "modelID": "minimax/minimax-m3:floor",
          "name": "MiniMax-M3 (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 512000 },
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache": { "read": 0.06 },
          },
        },
      },
    },
    "opencode-go": {},
    "synthetic": {},
    // V2 discovers pulled Ollama models automatically.
    "ollama": {
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
    },
  },
  // `provider` (singular) is deprecated in the V2 schema, but
  // @slkiser/opencode-quota still WRITES this declaration here — its `init` and
  // `provider add` commands target `["provider", providerId]`. Do not move it to
  // `providers`: the plugin rewrites it. Harmless, since V2 still accepts
  // deprecated keys, and the provider is also discoverable from auth.json.
  "provider": {
    "opencode": {}
  },
}
