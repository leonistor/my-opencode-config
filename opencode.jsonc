{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "plugins": [
    // opencode-history-search: V1-only upstream (its V2 PRs sit unmerged). Superseded
    // 2026-11-12 by ctx (ctx.rs): CLI + skill installed in ~/.agents/skills — ctx
    // itself needs no plugin entry. But ctx 2.4.1 rejects this machine's opencode.db
    // (BOTH schema generations populated by the V1→V2 in-place migration; upstream
    // report pending), so the frozen V2 port below covers OpenCode-history search
    // until ctx imports it. Drop it then — it reads session_v2 read-only, 1.0.0.
    // Its data-dir resolution misses this machine (host DB at ~/.local/share/opencode,
    // a V1-migration location the plugin does not mirror; it expects
    // ~/Library/Application Support/opencode). Fixed by the symlink
    // ~/Library/Application Support/opencode/opencode.db → the real DB. Remove the
    // symlink together with the plugin entry when ctx takes over.
    "opencode-history-search-v2@latest",
    // "opencode-history-search",
    // opencode-pty: cannot load as a package spec on V2 (its V2 build is a
    // subpath export, `opencode-pty/v2`, which OpenCode parses as a git spec).
    // Loaded via a local plugin package instead: plugins/opencode-pty/
    "@upstash/context7-opencode",
    // cmux: OpenCode integration is now a loose plugin installed by
    // `cmux agent hook install opencode` → plugins/cmux-tui-journal.js
    // (auto-discovered, no array entry and no id collision). The old
    // ./plugins/cmux feed/session bridge was retired with the cmux-tui rewrite.
    "oh-my-opencode-slim",
    // Plannotator's own plugin: the Inbox (threads, questions, attachments
    // annotated in place) plus plan review via `submit_plan`, which replaced
    // open-plan-annotator's `annotate_plan`. Two plugins that both register a
    // plan tool inject contradictory system prompts on the `plan` agent, so
    // only one may be loaded — this one. Removed 2026-10-24.
    // The `plannotator_inbox` tool is off by default for OpenCode; the file
    // ~/.plannotator/config.json turns it on via `inboxTool.opencode`. Plugins
    // load at process start, so this applies to a new session, not this one.
    "@plannotator/opencode",
    "opencode-mem@latest",
  ],
  "agents": {
    // oh-my-opencode-slim provides its own `explorer` subagent and the
    // `orchestrator`; disable the built-in explore/general agents.
    "explore": { "disabled": true },
    "general": { "disabled": true },
  },
  // OpenPencil design tooling for the `pencil` subagent
  // (oh-my-opencode-slim.json → agents.pencil). The stdio bridge discovers the
  // running desktop app and scopes file operations to the workspace
  // (OPENPENCIL_MCP_ROOT defaults to cwd), so a session edits the .fig inside its
  // own project and nothing else.
  //
  // Shipped OFF by default: design work is the exception, not the rule, and the
  // entry otherwise spawns a bridge process in every session. Turn it on where
  // it is actually needed, without editing this file:
  //   - per session/location: `/mcps` → open-pencil → connect
  //   - per project: repeat the FULL entry under "mcp.servers.open-pencil" in
  //     that project's opencode config — type, command, environment — with no
  //     "disabled" flag (defaults to false, i.e. connect). V2 replaces a
  //     same-name server entry wholesale, so the old V1 partial toggle
  //     `{ "open-pencil": { "enabled": true } }` (still accepted by the
  //     schema!) is silently ignored by the runtime. Working example:
  //     ~/work/darius/la-ade-insta-static/.opencode/opencode.jsonc.
  // The permanent off-switch for every agent is "open-pencil" in `disabled_mcps`
  // in oh-my-opencode-slim.json; that one is not meant to be toggled.
  //
  // Context: omo-slim compiles each agent's `mcps` list into `open-pencil_*`
  // permission rules, so the orchestrator and every omo-slim specialist deny the
  // server outright. Host built-ins (`plan`, `build`) are not managed by omo-slim
  // and see only the collapsed Code Mode catalog entry — a two-line
  // "open-pencil (42 tools)" pointer, not the schemas. Inside `pencil` the
  // 42-tool set is reachable through `execute` plus `search`. The app must be
  // open with a document: without it, tool calls answer "start the app" (or time
  // out on a wedged bridge) and the agent stops instead of retrying.
  "mcp": {
    "servers": {
      "open-pencil": {
        "type": "local",
        "disabled": true,
        "command": ["openpencil-mcp"],
        // Left on the host's default Code Mode on purpose. A per-server
        // `"codemode": false` gives direct `open-pencil_<tool>` tools but the
        // setting is server-wide, not per-agent: it would put all 42 schemas
        // (~9.8k tokens) into every plan/build session too. In Code Mode the
        // pencil subagent gets one catalog entry plus `search`, and a built-in
        // session sees a two-line "open-pencil (42 tools)" pointer — measured in
        // this host's own catalog after a config reload.
        "environment": {
          // The wireframe set: build, layout, components, text, verification. No
          // variables/design-system plumbing, vectors, booleans, diff, icons,
          // comments, settings or eval. `update_node` covers text, size and
          // corner radius, so set_text/set_radius/node_move/node_resize stay off.
          "OPENPENCIL_MCP_DISABLED_TOOLS": "get_selection,set_radius,set_text,node_resize,stock_photo,diff_create,diff_jsx,diff_visual,calc,viewport_zoom_to_fit,select_nodes,list_libraries,insert_library_component,page_bounds,get_comments,add_comment,reply_to_comment,resolve_comment,get_font_status,list_fonts,list_available_fonts,search_icons,insert_icon,fetch_icons,combine_as_variants,expose_instance_swap,create_slot,get_behaviour,set_behaviour,create_vector,create_slice,import_svg,set_effects,set_opacity,set_font,set_rotation,set_font_range,set_blend,set_locked,set_stroke_align,set_image_fill,node_move,flatten_nodes,node_bounds,node_ancestors,node_children,node_tree,node_bindings,node_replace_with,list_variables,list_collections,get_variable,find_variables,create_variable,set_variable,delete_variable,bind_variable,unbind_variable,get_collection,create_collection,delete_collection,boolean_union,boolean_subtract,boolean_intersect,boolean_exclude,path_get,path_set,path_scale,path_flip,path_move,viewport_get,viewport_set,export_svg,export_pdf,analyze_colors,analyze_typography,lint_fix,analyze_spacing,analyze_clusters,analyze_overlaps,diff_show,diff_apply,design_to_tokens,import_design_tokens,design_to_component_map,close_file,activate_document,get_settings,update_settings,get_codegen_prompt"
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "deny",
    },
    { "action": "provider.use", "resource": "huggingface", "effect": "deny" },
  ],
  "permissions": [
    // V2 rules resolve last-match-wins, and these user rules are appended
    // AFTER shipped agent rules. Do NOT add blanket allow rules here such as
    // `{ "action": "*" }` or `{ "action": "edit" }`: they would override
    // agent-level denials, e.g. the read-only `plan` agent. Every agent
    // already starts from a built-in allow-everything base policy.
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    // V2 defaults to `ask` for `.env`/`.env.*` reads; keep them allowed.
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "read", "resource": "*.env-*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    // Shell rules (V1 `permission.bash`). Only deny the truly catastrophic.
    { "action": "shell", "resource": "bun *", "effect": "allow" },
    { "action": "shell", "resource": "bunx *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    // Deny only exact root/home wipes. Do NOT add `rm -rf /*` or `rm -rf ~/*`:
    // the glob `*` matches across `/`, so those rules also block routine
    // cleanup of absolute paths (e.g. `rm -rf /tmp/x`) and surface to agents as
    // "Permission denied: shell" / a missing shell tool.
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": ":(){:|:&};:", "effect": "deny" }, // fork bomb, just in case
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
    ],
  },
  "providers": {
    "openrouter": {
      "models": {
        // :floor declarations for the live presets only (the 2026-11-13
        // consolidation dropped eight others, none with a live consumer):
        // this one carries the nomoney/openrouter volume lanes; the MiniMax
        // one below also backs opencode-mem auto-capture.
        "deepseek/deepseek-v4.1-flash:floor": {
          "modelID": "deepseek/deepseek-v4.1-flash:floor",
          "name": "DeepSeek V4.1 Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 943718 },
          "cost": {
            "input": 0.00405,
            "output": 0.72,
            "cache": { "read": 0.0054 },
          },
        },
        // Declared at the cheapest eligible endpoint (Tenstorrent, fp8, 1M
        // context). The plain catalogue model is 0.15 / 0.60 / cache 0.015;
        // floor routes below it, so a declaration at the plain rate would
        // overstate this lane ~3x. Re-check against
        // GET /api/v1/models/minimax/minimax-m3.1-flash/endpoints when it moves.
        "minimax/minimax-m3.1-flash:floor": {
          "modelID": "minimax/minimax-m3.1-flash:floor",
          "name": "MiniMax-M3.1-Flash (:floor)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "limit": { "context": 1048576, "output": 524288 },
          "cost": {
            "input": 0.05,
            "output": 0.2,
            "cache": { "read": 0.005 },
          },
        },
      },
    },
    "opencode-go": {},
    // Mistral: API key lives in the environment (MISTRAL_API_KEY, set in
    // ~/.bash_profile); models are auto-discovered from models.dev until a
    // preset pins a selection here.
    "mistral": {},
    // V2 discovers pulled Ollama models automatically.
    "ollama": {
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
    },
  },
}
