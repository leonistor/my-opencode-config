      "skills": [],
      "mcps": ["open-pencil"],
      "permission": {
        "edit": {
          "*": "deny",
          "docs/design/**": "allow"
        }
      },
      "orchestratorPrompt": "@pencil — OpenPencil wireframes and component skeletons. Delegate: new screen or flow layouts, component anatomy and variants, populating frames with real text from project data (fixtures, types, specs). Don't: visual polish or finished prototypes (@designer), React implementation (@fixer), architecture (@oracle). Needs the OpenPencil desktop app open with a document."
