{
  "$schema": "https://opencode.ai/v2/cli.json",
  "mouse": true,
  "theme": {
    "name": "ayu"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "plugins": ["oh-my-opencode-slim"],
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
