{
  "$schema": "https://opencode.ai/v2/cli.json",
  "mouse": true,
  "theme": {
    "name": "ayu-dark"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1,
    "sound_pack": "opencode.default"
  },
  "plugins": [
    "oh-my-opencode-slim",
    "@slkiser/opencode-quota@4"
  ],
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
