node_modules
package.json
bun.lock
**/*.lock
**/*.bak
*.bak

# Contains the live OpenCode background-service password. Never commit it.
service.json

# V1-shaped config files that `cmux hooks setup` and the oh-my-opencode-slim
# installer regenerate (cmux writes opencode.json, then omos appends to it).
# The real config is opencode.jsonc; these are redundant generated artifacts.
opencode.json
opencode.json.bak
tui.json
.*.write-lock/

# Keep the opencode-pty local plugin package manifest (its dependency on the
# opencode-pty package is needed to install/reproduce the plugin).
!plugins/opencode-pty/package.json

# cmux-generated OpenCode plugin. cmux marks these "DO NOT EDIT MANUALLY"
# because it rewrites them in place, but this repo tracks them so a fresh
# clone reproduces the working cmux integration.
!plugins/cmux/package.json
