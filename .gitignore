node_modules
package.json
bun.lock
**/*.lock
**/*.bak
*.bak

# Contains the live OpenCode background-service password. Never commit it.
service.json

# V1-shaped config files that the oh-my-opencode-slim installer regenerates
# (opencode.json, which omos appends to). The real config is opencode.jsonc;
# these are redundant generated artifacts.
opencode.json
opencode.json.bak
tui.json
.*.write-lock/

# Keep the opencode-pty local plugin package manifest (its dependency on the
# opencode-pty package is needed to install/reproduce the plugin).
!plugins/opencode-pty/package.json
